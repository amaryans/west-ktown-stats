# Copy to .env for local development. Both values come from your Supabase
# project: Project Settings -> API. The anon key is safe to expose in the
# browser; row-level security in supabase/schema.sql is what protects data.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Only needed for scripts/file-suggestions.mjs (never ship these to the browser).
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# GITHUB_TOKEN=ghp_...
# GITHUB_REPOSITORY=amaryans/west-ktown-stats
